[user]
	name = syott-root
	email = sys@syott.co
	username = syott-root
	signingkey = 424CA127A92CB146
[core]
    editor = nvim
	sshCommand = ssh -i ~/.ssh/syott_root_ed25519 -o IdentitiesOnly=yes
[column]
    ui = auto
[diff]
	algorithm = histogram
	colorMoved = plain
	renames = true
	tool = nvimdiff
[web]
	browser = google-chrome
[color "branch"]
	current = yellow bold
	local = green bold
	remote = cyan bold
[pull]
    rebase = true
[commit]
	gpgsign = true
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
