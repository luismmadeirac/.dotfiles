[user]
	name = syott-root
	email = sys@syott.co
	username = syott-root
	signingkey = 424CA127A92CB146
[core]
    editor = nvim
	sshCommand = ssh -i /Users/luismadeira/.ssh/syott_root_ed25519 -o IdentitiesOnly=yes
	quotePath = false
	commitGraph = true
[column]
    ui = auto
[diff]
	algorithm = histogram
	colorMoved = plain
	renames = true
	tool = nvimdiff
[web]
	browser = open
[color "branch"]
	current = yellow bold
	local = green bold
	remote = cyan bold
[pull]
    rebase = true
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[gc]
	writeCommitGraph = true
[fetch]
	writeCommitGraph = true
[url "https://git.internal.syott.co/"]
	insteadOf = ssh://git@git.internal.syott.co/

# Per-directory identities. Keep these last: later settings win in git,
# so anything below would override the included files.

# CGI repos
[includeIf "gitdir:~/work-cgi/"]
	path = config-cgi

# Syott repos
[includeIf "gitdir:~/work/syott/"]
	path = config-syott
